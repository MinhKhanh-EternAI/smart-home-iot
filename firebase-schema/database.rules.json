{
  "rules": {
    ".read": false,
    ".write": false,

    "devices": {
      ".read": "auth != null",
      ".write": "auth != null",
      "indoor_light": {
        "status": { ".validate": "newData.isBoolean()" },
        "mode": { ".validate": "newData.isString()" },
        "schedule": { ".validate": "newData.hasChildren(['enabled', 'on_time', 'off_time', 'days'])" }
      },
      "outdoor_light": {
        "status": { ".validate": "newData.isBoolean()" },
        "mode": { ".validate": "newData.isString()" }
      },
      "door": {
        "status": { ".validate": "newData.isString() && (newData.val() == 'open' || newData.val() == 'closed')" },
        "auto_close_ms": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 60000" }
      },
      "fan": {
        ".validate": "newData.isBoolean() || newData.hasChildren(['status'])",
        "status": { ".validate": "newData.isBoolean()" }
      }
    },

    "sensors": {
      ".read": "auth != null",
      ".write": "auth != null",
      "temperature": { ".validate": "newData.isNumber()" },
      "humidity": { ".validate": "newData.isNumber()" },
      "motion": { ".validate": "newData.isBoolean()" },
      "rain": { ".validate": "newData.isBoolean()" },
      "last_updated": { ".validate": "newData.isNumber()" },
      "history": {
        "$entry_id": {
          "timestamp": { ".validate": "newData.isNumber()" },
          "temperature": { ".validate": "newData.isNumber()" },
          "humidity": { ".validate": "newData.isNumber()" }
        }
      }
    },

    "logs": {
      ".read": "auth != null",
      "event_logs": {
        ".write": "auth != null",
        "$event_id": {
          "timestamp": { ".validate": "newData.isNumber()" },
          "type": { ".validate": "newData.isString()" },
          "message": { ".validate": "newData.isString()" }
        }
      }
    },

    "rfid": {
      "cards": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$card_uid": {
          "name": { ".validate": "newData.isString()" },
          "active": { ".validate": "newData.isBoolean()" },
          "created_at": { ".validate": "newData.isNumber()" }
        }
      },
      "access_logs": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$log_id": {
          "timestamp": { ".validate": "newData.isNumber()" },
          "card_uid": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString()" },
          "status": { ".validate": "newData.isString()" }
        }
      }
    },

    "status": {
      ".read": "auth != null",
      "esp8266": {
        ".write": "auth != null",
        "ip": { ".validate": "newData.isString()" },
        "last_seen": { ".validate": "newData.isNumber()" }
      },
      "esp32": {
        ".write": "auth != null",
        "ip": { ".validate": "newData.isString()" },
        "last_seen": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
