#ifndef SECRETS_H
#define SECRETS_H

// ==========================================================
// BÍ MẬT FIREBASE — KHÔNG commit file Secrets.h lên git!
//
// Hướng dẫn:
//   1. Sao chép file này thành  include/Secrets.h
//   2. Điền thông tin Firebase dự án của bạn vào bên dưới
//   3. Kiểm tra .gitignore đã có dòng "include/Secrets.h"
//
// Lấy thông tin tại: Firebase Console → Project Settings → General
// ==========================================================

#define FIREBASE_HOST    "YOUR_PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app"
#define FIREBASE_API_KEY "YOUR_FIREBASE_API_KEY"

#endif // SECRETS_H
